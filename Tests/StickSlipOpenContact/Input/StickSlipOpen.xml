<?xml version="1.0" encoding="UTF-8"?>
<!-- This XML input file is a shortcut to preprocess the model for each domain
in a nonConforming simulation.
-->

<Problem>

  <SimulationParameters
                        Start="0."
                        End ="16.0"
                        DtInit="1"
                        DtMin ="1e-4"
                        DtMax ="1"
                        incrementFactor = "1.5"
                        choppingFactor = "2"
                        MaxNLIteration = "20"
                        RelativeTolerance = "1.e-9"
                        AbsoluteTolerance = "1.e-11"
                        resetConfiguration = "0"
                        />

  <Interface>
    <SolidMechanicsContact_stab
                                         augmentationParameter = "1e4"
                                         multiplierType = "P0"
                                         isSmooth = "0"
                                         stabilizationScale = "1.0"
                                         masterDomain = "1" masterSurface = "6"
                                         slaveDomain = "2" slaveSurface = "5">

      <Quadrature
                  type = "SegmentBasedQuadrature"
                  gaussOrder = "4"
                  />

      <Coulomb
               cohesion = "0.0"
               frictionAngle = "30" />

      <ActiveSet
                 resetActiveSet = "0"
                 forceStickBoundary = "0" >

        <Tolerances
                    normalGap = "1e-5"
                    normalTraction = "-1e-3"
                    tangentialViolation = "0.0"
                    minLimitTraction = "1e-4"
                    areaChange = "1e-4"
                    />

      </ActiveSet>

    </SolidMechanicsContact_stab>

  </Interface>


</Problem>
