<?xml version="1.0" encoding="UTF-8"?>
<Problem>

  <simParam>
    <Time
          Start="0."
          End ="1.0"
          DtInit="1.0"
          DtMin ="1.0"
          DtMax ="1.0"
          incrementFactor = "1.1"
          choppingFactor = "Default" />

    <Solver
            Theta = "Default"
            MaxNLIteration = "10"
            RelativeTolerance = "1.e-8"
            AbsoluteTolerance = "1.e-9" />
  </simParam>


  <Output
          outputFile = "Output/results"
          matFileName = "Output/results"
          saveHistory = "1"
          printTimes = "1.0"
          />
 


  <Materials>
    <Solid cellTags = "1">
      <Constitutive>
        <Elastic
                 youngModulus = "1e5"
                 poissonRatio = "0.25"
                 />
      </Constitutive>

      <PorousRock
                  porosity = "0.375"
                  specificWeight = "2.1e1"
                  biotCoefficient = "1."
                  permeability = "1e-12, 1e-12, 1e-12"
                  />
    </Solid>


    <Fluid
           specificWeight = "0.0"
           compressibility = "4.4e-7"
           dynamicViscosity = "1.0e-6"
           />
  </Materials>


  <BoundaryConditions>
    <!-- Boundary Conditions to Flow -->
    <!-- Top -->
    <BC name = "NoFlowTop"
        type = "Dirichlet"
        entityType = "SurfBC"
        variable = "pressure" >

      <BCentities surfaceTags = "2" />
      <BCevent time = "0." value = "0.000000e+00" />
    </BC>

    <!-- Boundary Conditions to Mechanics -->
    <!-- Top-->
    <BC name = "TopLoad"
        type = "Neumann"
        entityType = "SurfBC"
        variable = "displacements" >

      <BCentities surfaceTags = "2" components = "z" />
      <BCevent time = "0." value = "-1.000000e+01" />
    </BC>

    <!-- Lateral Y -->
    <BC name = "LatFixedY"
        type = "Dirichlet"
        entityType = "NodeBC"
        variable = "displacements" >

      <BCentities surfaceTags = "3,4" components = "y" />
      <BCevent time = "0." value = "0.000000e+00" />
    </BC>

    <!-- Lateral X -->
    <BC name = "LatFixedX"
        type = "Dirichlet"
        entityType = "NodeBC"
        variable = "displacements" >

      <BCentities surfaceTags = "5,6" components = "x" />
      <BCevent time = "0." value = "0.000000e+00" />
    </BC>

    <!-- Bottom -->
    <BC name = "BotFixed"
        type = "Dirichlet"
        entityType = "SurfBC"
        variable = "displacements" >

      <BCentities surfaceTags = "1" components = "x,y,z" />
      <BCevent time = "0." value = "0.000000e+00" />
    </BC>

  </BoundaryConditions>


  <Solver>
    <BiotFullySaturated>
      <Poromechanics cellTags = "1" />
      <SinglePhaseFlowFEM targetRegions = "1" />
    </BiotFullySaturated>
  </Solver>

</Problem>
