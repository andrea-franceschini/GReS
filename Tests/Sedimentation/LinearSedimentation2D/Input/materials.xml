<?xml version="1.0" encoding="UTF-8"?>

<Materials>
  <Solid name = "peat"
         cellTags = "1">
    <Constitutive>
      <SedimentMaterial
          voidRate = "15."
          voidLowerLimit = "10."
          voidUpperLimit = "20."
          conductivity = "0.9450e+1, 0.9450e+1, 0.315e+1"
          initStress = "1e+0"
          preStress = "1e+2"
          specificWeight = "2.0e3"
          compressibilityIndex = "4.00"
          reCompressibilityIndex = "0.40"
      />
    </Constitutive>
  </Solid>

  <Solid name = "clay"
         cellTags = "2">
    <Constitutive>
      <SedimentMaterial
          voidRate = "10."
          voidLowerLimit = "7.5"
          voidUpperLimit = "12.5"
          conductivity = "0.9450e-1, 0.9450e-1, 0.315e-1"
          initStress = "1e+0"
          preStress = "1e+2"
          specificWeight = "2.7e3"
          compressibilityIndex = "3.00"
          reCompressibilityIndex = "0.10"
      />
    </Constitutive>
  </Solid>

  <Solid name = "silt"
         cellTags = "3">
    <Constitutive>
      <SedimentMaterial
          voidRate = "3."
          voidLowerLimit = "2."
          voidUpperLimit = "4."
          conductivity = "0.9450e+1, 0.9450e+1, 0.315e+1"
          initStress = "1e+0"
          preStress = "1e+2"
          specificWeight = "2.7e3"
          compressibilityIndex = "0.5"
          reCompressibilityIndex = "0.05"
      />
    </Constitutive>
  </Solid>

  <Solid name = "base"
         cellTags = "4">
    <Constitutive>
      <SedimentMaterial
          voidRate = "15."
          voidLowerLimit = "10."
          voidUpperLimit = "20."
          conductivity = "0.9450e+1, 0.9450e+1, 0.315e+1"
          initStress = "1e+0"
          preStress = "1e+2"
          specificWeight = "2.0e3"
          compressibilityIndex = "4.00"
          reCompressibilityIndex = "0.40"
      />
    </Constitutive>
  </Solid>

  <Fluid
      specificWeight = "1.0e3"
      compressibility = "0.432e-8"
  />
  
</Materials>

<!--
In the <Solid name = "X" cellTags = "XXX"> we specify all the properties
associated with the rock.
For the sedimentation simulation, the cellTag assign the material to a
number tag. 
The <Constitutive> block holds the parameters of the specific constitutive
model, for this case, for the sedimentation.

The sedimentation materail is define by:
 - voidRate - the experimental value for the void rate.
 - voidLowerLimit - the lower limit for the void rate for this material
 - voidUpperLimit - the upper limit for the void rate for this material
 - conductivity - the hydraulic condutivity of the material
 - initStress - the initial stress of this material
 - preStress - the initial preconsolidated stress for the material
 - specificWeight - the specific weight of this rock
 - compressibilityIndex - the compressibility index of the rock
 - reCompressibilityIndex - the recompressibility index of the rock
-->