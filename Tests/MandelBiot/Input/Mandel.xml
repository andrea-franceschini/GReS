<?xml version="1.0" encoding="UTF-8"?>
<model>
  <!-- Simulation parameters common to all physical models -->
  <simParam>
    <Time
          Start="0."
          End ="5.01"
          DtInit= "2.5e-2"
          DtMin ="1.e-5"
          DtMax ="1.e-1"
          incrementFactor = "1."
          choppingFactor = "Default" />

    <Solver
            Theta = "Default"
            MaxNLIteration = "10"
            RelativeTolerance = "1.e-8"
            AbsoluteTolerance = "1.e-9" />
  </simParam>

  <Materials>
    <Solid cellTags = "1">
      <Constitutive>
        <Elastic
                 youngModulus = "1.e5"
                 poissonRatio = "0.25"
                 />
      </Constitutive>

      <PorousRock
                  porosity = "0.375"
                  specificWeight = "2.1e1"
                  biotCoefficient = "1."
                  permeability = "1e-12, 1e-12, 1e-12"
                  />
      <!-- porosity (Adimensional, between 0 and 1),
specificGravity (kg/m^3 ),
permeability (m^2) -->
    </Solid>


    <Fluid
           specificWeight = "0.0"
           compressibility = "4.4e-7"
           dynamicViscosity = "1.0e-6"
           />
    <!-- specific weight (N/m3),
fluid compressibility (Pa-1),
dynamic viscosity (Pa/s)
-->
  </Materials>

  <Output
          outputFile = "Output/results"
          matFileName = "Output/results"
          saveHistory = "1"
          printTimes = "0.05,0.25,1,2.5,5"
          />

  <Solver>
    <BiotFullySaturated>
      <Poromechanics cellTags = "1" />
      <SinglePhaseFlowFVTPFA targetRegions = "1" />
    </BiotFullySaturated>
  </Solver>



  <BoundaryConditions>

    <!-- Boundary Conditions to Flow -->
    <!-- Top -->
    <BC name = "LatNoFlow"
        type = "Dirichlet"
        entityType = "SurfBC"
        variable = "pressure" >

      <BCentities surfaceTags = "6" />
      <BCevent time = "0." value = "0.000000e+00" />
    </BC>

    <!-- Boundary Conditions to Mechanics -->
    <!-- Top -->
    <BC name = "TopLoad"
        type = "Neumann"
        entityType = "SurfBC"
        variable = "displacements" >

      <BCentities surfaceTags = "2" components = "z" />
      <BCevent time = "0." value = "-1.000000e+01" />
    </BC>

    <!-- Lateral Y -->
    <BC name = "LatFixedY"
        type = "Dirichlet"
        entityType = "SurfBC"
        variable = "displacements" >

      <BCentities surfaceTags = "3,4" components = "y" />
      <BCevent time = "0." value = "0.000000e+00" />
    </BC>

    <!-- Lateral X -->
    <BC name = "LatFixedX"
        type = "Dirichlet"
        entityType = "SurfBC"
        variable = "displacements" >

      <BCentities surfaceTags = "5" components = "x" />
      <BCevent time = "0." value = "0.000000e+00" />
    </BC>

    <!-- Bottom -->
    <BC name = "BotFix"
        type = "Dirichlet"
        entityType = "SurfBC"
        variable = "displacements" >

      <BCentities surfaceTags = "1" components = "z" />
      <BCevent time = "0." value = "0.000000e+00" />
    </BC>

  </BoundaryConditions>
</model>