<?xml version="1.0" encoding="UTF-8"?>

<Problem>

  <SimulationParameters
                        Start="0.0"
                        End ="1e0"
                        DtInit= "1e0"
                        DtMax ="1e0"
                        DtMin ="1e-2"
                        AbsoluteTolerance = "1e-11"
                        RelativeTolerance = "1e-9"
                        MaxNLIteration = "30">

    <LinearSolver useMatlab = "1"/>
    
    </SimulationParameters>



    <Materials>
      <Solid
             cellTags = " 1 ">
        <Constitutive>
          <Elastic
                   youngModulus = "50.0"
                   poissonRatio = "0.3"
